<mujoco model="arm_exoskeleton_3d">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>

  <option timestep="0.005" gravity="0 0 -9.80665" integrator="RK4"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <joint damping="0.02" armature="0.01" limited="true"/>
    <geom condim="3" friction="0.8 0.02 0.001"/>
    <motor ctrllimited="true"/>
  </default>

  <asset>
    <material name="upper_arm_mat" rgba="0.22 0.43 0.82 1"/>
    <material name="forearm_mat" rgba="0.20 0.66 0.52 1"/>
    <material name="exo_mat" rgba="0.84 0.74 0.28 1"/>
    <material name="payload_mat" rgba="0.85 0.26 0.22 1"/>
    <material name="floor_mat" rgba="0.55 0.57 0.60 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -3 3" dir="0 1 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="2 2 0.05" material="floor_mat"/>

    <body name="torso_anchor" pos="0 0 1.25">
      <geom name="torso_stub" type="box" pos="-0.08 0 0" size="0.08 0.12 0.20" rgba="0.35 0.35 0.38 1"/>
      <site name="shoulder_site" pos="0 0 0" size="0.025" rgba="1 1 1 1"/>

      <body name="upper_arm" pos="0 0 0">
        <!-- Axis 0 -1 0 makes positive joint angles lift the arm upward. -->
        <joint name="shoulder_flexion" type="hinge" axis="0 -1 0" range="-45 130" damping="0.60"/>
        <geom name="upper_arm_geom" type="capsule" fromto="0 0 0 0.31 0 0" size="0.04" mass="2.1" material="upper_arm_mat"/>
        <geom name="upper_exo_bar" type="capsule" fromto="0 0.055 0 0.31 0.055 0" size="0.015" mass="0.35" material="exo_mat"/>

        <body name="forearm" pos="0.31 0 0">
          <joint name="elbow_flexion" type="hinge" axis="0 -1 0" range="0 150" damping="0.35"/>
          <geom name="forearm_geom" type="capsule" fromto="0 0 0 0.34 0 0" size="0.035" mass="1.65" material="forearm_mat"/>
          <geom name="forearm_exo_bar" type="capsule" fromto="0 0.05 0 0.34 0.05 0" size="0.013" mass="0.28" material="exo_mat"/>

          <body name="payload" pos="0.34 0 0">
            <site name="hand_site" pos="0 0 0" size="0.025" rgba="1 1 1 1"/>
            <geom name="payload_geom" type="box" pos="0.08 0 -0.02" size="0.08 0.08 0.08" mass="5.0" material="payload_mat"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder_flexion" gear="1" ctrlrange="-80 80"/>
    <motor name="elbow_motor" joint="elbow_flexion" gear="1" ctrlrange="-60 60"/>
  </actuator>
</mujoco>
