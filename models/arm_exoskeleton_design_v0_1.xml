<mujoco model="arm_exoskeleton_design_v0_1">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>

  <option timestep="0.005" gravity="0 0 -9.80665" integrator="RK4"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <joint damping="0.02" armature="0.01" limited="true"/>
    <geom condim="3" friction="0.8 0.02 0.001"/>
    <motor ctrllimited="true"/>
  </default>

  <asset>
    <material name="upper_arm_mat" rgba="0.22 0.43 0.82 1"/>
    <material name="forearm_mat" rgba="0.20 0.66 0.52 1"/>
    <material name="exo_mat" rgba="0.84 0.74 0.28 1"/>
    <material name="cuff_mat" rgba="0.08 0.08 0.10 1"/>
    <material name="strap_mat" rgba="0.02 0.02 0.025 1"/>
    <material name="motor_mat" rgba="0.75 0.76 0.78 1"/>
    <material name="payload_mat" rgba="0.85 0.26 0.22 1"/>
    <material name="floor_mat" rgba="0.55 0.57 0.60 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -3 3" dir="0 1 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="2 2 0.05" material="floor_mat"/>

    <body name="torso_anchor" pos="0 0 1.25">
      <geom name="torso_stub" type="box" pos="-0.08 0 0" size="0.08 0.12 0.20" rgba="0.35 0.35 0.38 1"/>
      <geom name="backpack_plate" type="box" pos="-0.17 0 0.03" size="0.035 0.16 0.24" mass="0.75" rgba="0.18 0.18 0.20 1"/>
      <geom name="shoulder_motor_housing" type="cylinder" fromto="-0.03 -0.16 0.03 -0.03 -0.24 0.03" size="0.055" mass="0.55" material="motor_mat"/>
      <geom name="shoulder_transmission_cable" type="capsule" fromto="-0.03 -0.18 0.03 0 -0.06 0.01" size="0.006" mass="0.03" material="exo_mat"/>
      <site name="shoulder_site" pos="0 0 0" size="0.025" rgba="1 1 1 1"/>

      <body name="upper_arm" pos="0 0 0">
        <!-- Axis 0 -1 0 makes positive joint angles lift the arm upward. -->
        <joint name="shoulder_flexion" type="hinge" axis="0 -1 0" range="-35 125" damping="0.60"/>
        <geom name="upper_arm_geom" type="capsule" fromto="0 0 0 0.31 0 0" size="0.04" mass="2.1" material="upper_arm_mat"/>
        <geom name="upper_exo_bar" type="capsule" fromto="0 0.055 0 0.31 0.055 0" size="0.014" mass="0.20" material="exo_mat"/>
        <geom name="upper_arm_cuff_proximal" type="box" pos="0.11 0.058 0" size="0.030 0.014 0.070" mass="0.10" material="cuff_mat"/>
        <geom name="upper_arm_cuff_distal" type="box" pos="0.24 0.058 0" size="0.030 0.014 0.070" mass="0.11" material="cuff_mat"/>
        <geom name="upper_arm_strap_proximal" type="box" pos="0.11 0 0.062" size="0.035 0.062 0.008" mass="0.025" material="strap_mat"/>
        <geom name="upper_arm_strap_distal" type="box" pos="0.24 0 0.062" size="0.035 0.062 0.008" mass="0.025" material="strap_mat"/>
        <site name="upper_cuff_force_site" pos="0.24 0.07 0" size="0.012" rgba="1 0.85 0.2 1"/>

        <body name="forearm" pos="0.31 0 0">
          <joint name="elbow_flexion" type="hinge" axis="0 -1 0" range="0 145" damping="0.35"/>
          <geom name="elbow_motor_housing" type="cylinder" fromto="-0.015 -0.07 0 -0.015 -0.15 0" size="0.045" mass="0.40" material="motor_mat"/>
          <geom name="elbow_drive_plate" type="cylinder" fromto="-0.005 -0.055 0 -0.005 -0.075 0" size="0.060" mass="0.10" material="exo_mat"/>
          <geom name="forearm_geom" type="capsule" fromto="0 0 0 0.34 0 0" size="0.035" mass="1.65" material="forearm_mat"/>
          <geom name="forearm_exo_bar" type="capsule" fromto="0 0.05 0 0.34 0.05 0" size="0.012" mass="0.16" material="exo_mat"/>
          <geom name="forearm_cuff_proximal" type="box" pos="0.10 0.053 0" size="0.030 0.012 0.060" mass="0.09" material="cuff_mat"/>
          <geom name="forearm_cuff_distal" type="box" pos="0.25 0.053 0" size="0.030 0.012 0.055" mass="0.09" material="cuff_mat"/>
          <geom name="forearm_strap_proximal" type="box" pos="0.10 0 0.055" size="0.035 0.055 0.007" mass="0.02" material="strap_mat"/>
          <geom name="forearm_strap_distal" type="box" pos="0.25 0 0.050" size="0.035 0.052 0.007" mass="0.02" material="strap_mat"/>
          <geom name="handle_side_bracket" type="box" pos="0.31 0.045 -0.02" size="0.025 0.012 0.045" mass="0.06" material="exo_mat"/>
          <site name="forearm_cuff_force_site" pos="0.25 0.065 0" size="0.012" rgba="1 0.85 0.2 1"/>

          <body name="payload" pos="0.34 0 0">
            <site name="hand_site" pos="0 0 0" size="0.025" rgba="1 1 1 1"/>
            <geom name="payload_geom" type="box" pos="0.08 0 -0.02" size="0.08 0.08 0.08" mass="5.0" material="payload_mat"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder_flexion" gear="1" ctrlrange="-80 80"/>
    <motor name="elbow_motor" joint="elbow_flexion" gear="1" ctrlrange="-60 60"/>
  </actuator>
</mujoco>
